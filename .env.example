# Copy this to apps/api/.env and apps/web/.env.local

# ─── API ──────────────────────────────────────────────────
DATABASE_URL=
REDIS_URL=redis://localhost:6379
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...

# Storage (local or s3)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# AWS S3 (only needed when STORAGE_DRIVER=s3)
AWS_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# ─── WEB ──────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_to_a_long_random_string
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Canonical public origin. Every canonical URL, og:url, sitemap entry and
# JSON-LD URL is built from this. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://mypdfhub.mythosh.com
